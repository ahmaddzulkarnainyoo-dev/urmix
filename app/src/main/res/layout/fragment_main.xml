<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <com.winatra.urmix.views.ScrollableTabLayout
        android:id="@+id/main_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/urmix_primary_background"
        app:tabRippleColor="@color/urmix_accent"
        app:tabIconTint="@color/urmix_text_primary"
        app:tabIndicatorColor="@color/urmix_accent"
        app:tabSelectedTextColor="@color/urmix_text_primary"
        app:tabTextColor="@color/urmix_text_secondary"
        app:tabGravity="fill"
        app:tabMinWidth="60dp" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/main_tab_layout" />

</RelativeLayout>
