<?xml version="1.0" encoding="utf-8"?>
<!-- URMIX Home screen (blueprint v2 §3.1): Spotify-style greeting, quick-play grid
     and Made For You / Trending Audio / Podcasting horizontal carousels. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/urmix_primary_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="96dp">

        <com.winatra.urmix.views.NewPipeTextView
            android:id="@+id/home_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:text="@string/home_greeting_evening"
            android:textColor="@color/urmix_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.winatra.urmix.views.NewPipeTextView
            android:id="@+id/home_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="2dp"
            android:paddingEnd="16dp"
            android:text="@string/home_subtitle"
            android:textColor="@color/urmix_text_secondary"
            android:textSize="13sp" />

        <GridLayout
            android:id="@+id/home_quick_play_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:useDefaultMargins="true" />

        <com.winatra.urmix.views.NewPipeTextView
            android:id="@+id/home_trending_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:text="@string/home_trending_audio"
            android:textColor="@color/urmix_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_trending_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            tools:listitem="@layout/item_home_track_card" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/home_made_for_you"
                android:src="@drawable/urmix_badge_made4u" />

            <com.winatra.urmix.views.NewPipeTextView
                android:id="@+id/home_made_for_you_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/home_made_for_you"
                android:textColor="@color/urmix_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_made_for_you_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            tools:listitem="@layout/item_home_track_card" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/home_podcasting"
                android:src="@drawable/urmix_badge_podcasting" />

            <com.winatra.urmix.views.NewPipeTextView
                android:id="@+id/home_podcast_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/home_podcasting"
                android:textColor="@color/urmix_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_podcast_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            tools:listitem="@layout/item_home_track_card" />

        <ProgressBar
            android:id="@+id/home_loading"
            style="@style/Widget.AppCompat.ProgressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/urmix_spinner"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- URMIX offline banner (FASE 5 §12.2) -->
        <include
            android:id="@+id/offline_banner"
            layout="@layout/view_offline_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <com.winatra.urmix.views.NewPipeTextView
            android:id="@+id/home_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/home_empty"
            android:textColor="@color/urmix_text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
