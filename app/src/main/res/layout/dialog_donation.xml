<?xml version="1.0" encoding="utf-8"?>
<!-- URMIX donation sheet (FASE 6 §6): dark Spotify palette, Saweria + QRIS. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/urmix_card_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/urmix_donation_header" />

    <com.winatra.urmix.views.NewPipeTextView
        android:id="@+id/donation_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/donation_notification_title"
        android:textColor="@color/urmix_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.winatra.urmix.views.NewPipeTextView
        android:id="@+id/donation_sheet_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/donation_sheet_fallback_message"
        android:textColor="@color/urmix_text_secondary"
        android:textSize="14sp"
        tools:text="Bantu kami menjaga kelangsungan server URMIX." />

    <ImageView
        android:id="@+id/donation_sheet_qris"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/donation_notification_title"
        android:visibility="gone"
        tools:visibility="visible" />

    <Button
        android:id="@+id/donation_sheet_saweria"
        style="@style/Widget.AppCompat.Button.Colored"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/donation_sheet_open" />

    <Button
        android:id="@+id/donation_sheet_close"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        android:textColor="@color/urmix_text_secondary" />
</LinearLayout>
