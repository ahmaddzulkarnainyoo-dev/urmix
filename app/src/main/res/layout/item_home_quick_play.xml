<?xml version="1.0" encoding="utf-8"?>
<!-- URMIX quick-play tile (blueprint v2 §3.1): 2-column Spotify shortcut card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="64dp"
    android:layout_gravity="fill_horizontal"
    android:background="@drawable/bg_home_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/quick_play_thumbnail"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_home_thumbnail_rounded"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription"
        tools:src="@drawable/placeholder_thumbnail_video" />

    <com.winatra.urmix.views.NewPipeTextView
        android:id="@+id/quick_play_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/urmix_text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Liked Songs" />
</LinearLayout>
