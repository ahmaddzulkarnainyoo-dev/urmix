# URMIX release signing (FASE 6 §7.1) — DO NOT COMMIT the real file.
# Copy this template to 'keystore.properties' in the repo root, fill it in,
# and back the .jks file up outside the repo. Missing file = release stays
# unsigned (debug/continuous builds unaffected).
storeFile=/absolute/path/to/urmix-release.jks
storePassword=CHANGE_ME
keyAlias=urmix-release
keyPassword=CHANGE_ME